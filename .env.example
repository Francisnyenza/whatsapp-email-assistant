# =============================================================================
# Inbox on WhatsApp — environment contract
#
# Copy to `.env` and fill in. Every variable here is validated at boot by
# packages/shared/src/config/env.schema.ts — the process refuses to start on a
# missing or malformed value rather than failing later under load.
#
# NEVER commit a filled-in .env. Production values come from the platform's
# secret manager (AWS Secrets Manager / Azure Key Vault / GCP Secret Manager).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug                       # trace|debug|info|warn|error|fatal
API_PORT=3001
WORKER_PORT=3002
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Where the dashboard's browser code sends its requests, and the only origin its
# Content-Security-Policy lets it reach. Next bakes this in at build time — that
# is what the NEXT_PUBLIC_ prefix means — so it is a build input for the web app
# rather than a runtime setting, and changing it needs a rebuild. It is a public
# URL and holds no secret. Set it to something unparseable and the CSP fails
# closed on `connect-src` rather than widening, so a typo surfaces as a dashboard
# that loads no data instead of one that can talk to anywhere.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Datastores --------------------------------------------------------------
DATABASE_URL=postgresql://wea:wea_dev_password@localhost:5432/wea?schema=public
DATABASE_POOL_SIZE=20
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6379/1

# --- Object storage (S3-compatible; MinIO locally) ----------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wea-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Cryptography (ADR 0002) --------------------------------------------------
# Local development uses a static KEK. In production set KMS_KEY_ID instead and
# leave ENCRYPTION_MASTER_KEY unset — the boot check rejects a static key when
# NODE_ENV=production.
#   generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
KMS_PROVIDER=local                    # local|aws|azure|gcp
KMS_KEY_ID=
# Key for HMAC blind indexes on encrypted, searchable columns.
#   generate: openssl rand -base64 32
BLIND_INDEX_KEY=

# --- Auth ---------------------------------------------------------------------
#   generate: openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_COOKIE_NAME=wea_session
TOTP_ISSUER=Inbox on WhatsApp

# --- WhatsApp Business Cloud API ---------------------------------------------
# https://developers.facebook.com/docs/whatsapp/cloud-api
# The dialable number in E.164 that users message. Shown on the "verify your
# phone" screen — the id below is Meta's opaque handle and cannot be dialled.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Echoed back during Meta's webhook verification handshake (GET /webhooks/whatsapp)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Used to verify X-Hub-Signature-256 on every inbound webhook. Required.
WHATSAPP_APP_SECRET=

# --- Google / Gmail -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/oauth/google/callback
# Pub/Sub topic Gmail publishes mailbox changes to (users.watch)
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/gmail-push
GOOGLE_PUBSUB_VERIFICATION_AUDIENCE=http://localhost:3001/webhooks/gmail
GOOGLE_PROJECT_ID=

# --- Microsoft / Outlook / M365 -----------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common            # 'common' supports personal + work accounts
MICROSOFT_REDIRECT_URI=http://localhost:3001/v1/oauth/microsoft/callback
# Opaque secret echoed by Graph on every notification; we compare it constant-time.
MICROSOFT_WEBHOOK_CLIENT_STATE=
MICROSOFT_NOTIFICATION_URL=http://localhost:3001/webhooks/microsoft

# --- AI providers -------------------------------------------------------------
# All three are implemented. A provider named here must have its key set, or the
# process refuses to start — a selected provider that quietly does nothing is
# worse than one that says so.
#
# Anthropic has no embeddings API, so selecting it gives full analysis and
# keyword-only search. Naming a second provider that does have one is enough to
# get semantic search back:
#
#   AI_PRIMARY_PROVIDER=anthropic
#   AI_FALLBACK_PROVIDER=openai
#
# `none` runs the product without any model at all: mail still arrives, cards
# are plainer, and search works on keywords. A supported configuration, not a
# broken one — but it has to be said out loud rather than inferred from a blank
# key, because a blank key is far more often a mistake.
AI_PRIMARY_PROVIDER=openai            # openai|gemini|anthropic|none
# Tried once when the primary fails in a way a different provider could answer.
# `none` is the default because the alternative is a second bill nobody chose.
AI_FALLBACK_PROVIDER=none             # openai|gemini|anthropic|none
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_SMART=gemini-2.0-pro
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-5
# Hard ceilings enforced before the call is made, not after the bill arrives.
# How far back the backfill walks so a newly connected account's history becomes
# searchable, not only its future. 0 turns it off. Paced by the token budget
# below regardless of this value — a large mailbox arrives over days, not in one
# bill.
EMBEDDING_BACKFILL_DAYS=365
AI_MAX_TOKENS_PER_USER_DAY=200000
AI_MAX_TOKENS_PER_ORG_DAY=5000000
AI_REQUEST_TIMEOUT_MS=20000

# --- Speech & OCR -------------------------------------------------------------
SPEECH_TO_TEXT_PROVIDER=openai        # openai|google|azure
TEXT_TO_SPEECH_PROVIDER=openai
OCR_PROVIDER=tesseract                # tesseract|google-vision|azure-vision

# --- Billing ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_WEBHOOK_PER_MIN=6000

# --- Retention (days) ---------------------------------------------------------
RETENTION_BODY_DAYS=30
RETENTION_ATTACHMENT_DAYS=30
RETENTION_AUDIT_DAYS=365

# --- Observability ------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Leave unset: each service names itself (wea-api / wea-worker).
# OTEL_SERVICE_NAME=
SENTRY_DSN=
METRICS_ENABLED=true

